{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Extension (Chrome)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "dev:chrome"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Run Extension (Firefox)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "dev:firefox"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Build Extension (All)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "build"
            ],
            "console": "integratedTerminal"
        }
    ]
}